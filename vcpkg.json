{
  "name": "imframe",
  "version": "0.3.0",
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "freetype",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "glfw3",
    "glad",
    "freetype",
    "catch2",
    "implot"
  ],
  "features": {
    "vulkan-backend": {
      "description": "Vulkan rendering backend via SDL3 (Phase 20)",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        "vulkan-memory-allocator",
        {
          "name": "vulkan",
          "platform": "!osx"
        },
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "vulkan-binding"
          ]
        }
      ]
    },
    "metal-backend": {
      "description": "Metal rendering backend via SDL3 (Phase 21)",
      "dependencies": [
        {
          "name": "sdl3",
          "platform": "osx"
        },
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "metal-binding"
          ],
          "platform": "osx"
        }
      ]
    },
    "dx12-backend": {
      "description": "DirectX 12 rendering backend (Phase 22)",
      "dependencies": []
    },
    "webgpu-backend": {
      "description": "WebGPU rendering backend (Phase 23)",
      "dependencies": []
    }
  }
}
