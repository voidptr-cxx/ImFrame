# Normalise all text files to LF in the repository.
# Windows checkouts get CRLF via core.autocrlf; Linux/macOS stay LF.
* text=auto

# Source and config files — always LF
*.hpp       text eol=lf
*.cpp       text eol=lf
*.cu        text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf
*.in        text eol=lf

# Shell scripts — always LF (shebang requires it)
*.sh        text eol=lf

# Binary files — no line-ending conversion
*.png       binary
*.jpg       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.ico       binary
*.lib       binary
*.a         binary
*.so        binary
*.dll       binary
*.exe       binary
